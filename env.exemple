# =============================================================================
# air_twizy_hardware — exemplo de variáveis para docker-compose.yml na raiz
# =============================================================================
# Uso:
#   cp env.exemple .env
#   Edite os valores abaixo conforme sua máquina e sensores.
#
# O Compose carrega automaticamente o ficheiro .env na mesma pasta que
# docker-compose.yml (este repositório).
# =============================================================================

# --- Partilhado (ROS 2 / DDS / X11) ------------------------------------------
DISPLAY=:0
QT_X11_NO_MITSHM=1
ROS_DOMAIN_ID=42

# =============================================================================
# CÂMERA (workspace/camera-lucid — Lucid / Arena SDK / ROS 2 Humble)
# =============================================================================
# Imagem e contentor
CAMERA_IMAGE_NAME=air-twizy-camera:latest
CAMERA_CONTAINER_NAME=air_twizy_camera

# Middleware ROS 2
CAMERA_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Gere o XML com: ./workspace/camera-lucid/config/setup_fastdds.sh subscriber <interface>
# Depois copie o ficheiro gerado para fastdds_subscriber.xml ou ajuste o caminho abaixo.
CAMERA_FASTRTPS_DEFAULT_PROFILES_FILE=/arena_camera_ros2/config/fastdds_subscriber.xml

# Identificação da câmera (GigE / Arena)
CAMERA_SERIAL=
CAMERA_TOPIC=/camera/image_raw

# =============================================================================
# LIDAR (workspace/ouster-ros — driver Ouster ROS 2)
# =============================================================================
# Argumentos de *build* do Dockerfile oficial (imagem base ros:${ROS_DISTRO}-ros-core)
OUSTER_ROS_DISTRO=humble
OUSTER_RMW_IMPLEMENTATION=rmw_fastrtps_cpp

LIDAR_IMAGE_NAME=air-twizy-lidar:latest
LIDAR_CONTAINER_NAME=air_twizy_lidar

# Parâmetros típicos do launch (use manualmente dentro do contentor ou num override):
#   ros2 launch ouster_ros sensor.launch.xml sensor_hostname:=<IP_ou_hostname> [udp_dest:=...] [viz:=false]
# OUSTER_SENSOR_HOSTNAME=os-991234567890.local
# OUSTER_UDP_DEST=
# OUSTER_VIZ=true

# =============================================================================
# CARRO (workspace/twizy — air_twizy_simulation / interface + simulação)
# =============================================================================
CARRO_IMAGE_NAME=air-twizy-car:latest
CARRO_CONTAINER_NAME=air_twizy_car

# Flags usados pelos scripts do Twizy (run.sh / stack ROS)
TWIZY_GPU=false
TWIZY_LIDAR=false
TWIZY_INTERFACE=true
TWIZY_CAN_PORT=can2

# Runtime Docker: runc (CPU) ou nvidia (GPU). O run.sh do Twizy define runc/nvidia
# consoante TWIZY_GPU e nvidia-smi.
NVIDIA_RUNTIME=runc

# Volumes de desenvolvimento (caminhos relativos à raiz deste repositório)
TWIZY_HOST_FOLDER_PATH=./workspace/ros_packages
TWIZY_SHARED_FOLDER=./workspace/twizy/shared_folder
TWIZY_UTILS_PATH=./workspace/twizy/utils

# X11: o run.sh do Twizy cria /tmp/.docker.xauth — alinhe com o volume do contentor
TWIZY_XAUTHORITY=/tmp/.docker.xauth
XAUTHORITY=/tmp/.docker.xauth
