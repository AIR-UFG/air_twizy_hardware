# =============================================================================
# air_twizy_hardware — variables for root docker-compose.yml
# =============================================================================
# Usage:
#   cp env.exemple .env
#   Edit the values below for your machine and sensors.
#
# Compose automatically loads .env in the same directory as docker-compose.yml.
# =============================================================================

# --- Shared (ROS 2 / DDS / X11) ----------------------------------------------
DISPLAY=:0
QT_X11_NO_MITSHM=1
ROS_DOMAIN_ID=0
ROS_DISCOVERY_SERVER=twizy:11811
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# =============================================================================
# CAMERA (workspace/camera-lucid)
# =============================================================================
CAMERA_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
CAMERA_FASTRTPS_DEFAULT_PROFILES_FILE=
# Camera names and serials (comma-separated, same order).
# Each name publishes on /camera/<name>/image_raw.
# Discover serials: python3 /arena_camera_ros2/scripts/list_cameras.py
CAMERA_NAMES=left,top_front,top_left,top_right,back,right
CAMERA_SERIALS=243901924,243901980,243901923,243901918,243901915,243901926
CAMERA_COUNT=6
CAMERA_TOPICS=
CAMERA_CONFIG_FILE=
CAMERA_REQUIRE_SERIALS=false
CAMERA_DISCOVERY_TIMEOUT_MS=5000
CAMERA_WIDTH=1024
CAMERA_HEIGHT=768
CAMERA_PIXELFORMAT=bayer_rggb8
CAMERA_GAIN=20.0
CAMERA_EXPOSURE_TIME=25000.0
CAMERA_FRAME_RATE=10.0
CAMERA_QOS_RELIABILITY=best_effort
CAMERA_START_DELAY_SEC=3.0
CAMERA_SERIAL=
CAMERA_TOPIC=/camera/image_raw

# =============================================================================
# LIDAR (ouster_lidar)
# Host network: NM profile "Lidar" on enp11s0 (10.5.5.1/24) + dnsmasq-twizy — see README §3
# =============================================================================
SENSOR_HOSTNAME=10.5.5.92
VIZ=false
ROS_SUPER_CLIENT=true

# =============================================================================
# VEHICLE (workspace/twizy — car service)
# Image/container names are fixed in docker-compose.yml
# =============================================================================

# Flags used by Twizy scripts (run.sh / ROS stack)
TWIZY_GPU=false
TWIZY_LIDAR=false
TWIZY_INTERFACE=true
TWIZY_CAN_PORT=can2
TWIZY_RVIZ=false

# Docker runtime: runc (CPU) or nvidia (GPU)
NVIDIA_RUNTIME=runc

# Development volumes (paths relative to this repository root)
TWIZY_HOST_FOLDER_PATH=./workspace/twizy/ros_packages
TWIZY_SHARED_FOLDER=./workspace/twizy/shared_folder
TWIZY_UTILS_PATH=./workspace/twizy/utils
CONTAINER_FOLDER_PATH=/root/ros2_ws/src/

# X11: create with xauth before starting (see workspace/twizy/utils/run.sh)
XAUTHORITY=/tmp/.docker.xauth
