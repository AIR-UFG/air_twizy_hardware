# =============================================================================
# air_twizy_hardware — variáveis para docker-compose.yml na raiz
# =============================================================================
# Uso:
#   cp env.exemple .env
#   Edite os valores abaixo conforme sua máquina e sensores.
#
# O Compose carrega automaticamente o ficheiro .env na mesma pasta que
# docker-compose.yml (este repositório).
# =============================================================================

# --- Partilhado (ROS 2 / DDS / X11) ------------------------------------------
DISPLAY=:0
QT_X11_NO_MITSHM=1
ROS_DOMAIN_ID=0
ROS_DISCOVERY_SERVER=twizy:11811
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# =============================================================================
# CÂMERA (workspace/camera-lucid)
# =============================================================================
CAMERA_IMAGE_NAME=air-twizy-camera:latest
CAMERA_CONTAINER_NAME=air_twizy_camera
CAMERA_RMW_IMPLEMENTATION=rmw_fastrtps_cpp
CAMERA_FASTRTPS_DEFAULT_PROFILES_FILE=/arena_camera_ros2/config/fastdds_subscriber.xml
CAMERA_SERIAL=
CAMERA_TOPIC=/camera/image_raw

# =============================================================================
# LIDAR (ouster_lidar)
# =============================================================================
ROS_DISTRO=humble
SENSOR_HOSTNAME=10.5.5.92
VIZ=false
ROS_SUPER_CLIENT=true

# =============================================================================
# CARRO (workspace/twizy — interface + simulação)
# =============================================================================
CARRO_IMAGE_NAME=air-twizy-car-image:v1
CARRO_CONTAINER_NAME=twizy

# Flags usados pelos scripts do Twizy (run.sh / stack ROS)
TWIZY_GPU=false
TWIZY_LIDAR=false
TWIZY_INTERFACE=true
TWIZY_CAN_PORT=can2
TWIZY_RVIZ=false

# Runtime Docker: runc (CPU) ou nvidia (GPU)
NVIDIA_RUNTIME=runc

# Volumes de desenvolvimento (caminhos relativos à raiz deste repositório)
TWIZY_HOST_FOLDER_PATH=./workspace/twizy/ros_packages
TWIZY_SHARED_FOLDER=./workspace/twizy/shared_folder
TWIZY_UTILS_PATH=./workspace/twizy/utils
CONTAINER_FOLDER_PATH=/root/ros2_ws/src/

# X11: criar com xauth antes de subir (ver workspace/twizy/utils/run.sh)
XAUTHORITY=/tmp/.docker.xauth
